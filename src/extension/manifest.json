{
  "manifest_version": 3,
  "name": "Mocklane",
  "version": "1.0.0",
  "description": "Local-first Fetch and XMLHttpRequest mocks managed by Mocklane CLI.",
  "permissions": [],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Mocklane"
  }
}
