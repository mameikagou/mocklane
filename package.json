{
  "name": "mocklane",
  "version": "1.0.1",
  "description": "A small, AI-first browser API mock tool for Chrome and Tabbit.",
  "type": "module",
  "bin": {
    "mocklane": "bin/mocklane.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dashboard": "rspack --config rspack.config.cjs",
    "build:extension": "node scripts/build-extension.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "typecheck": "node scripts/typecheck.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@rspack/cli": "^1.4.11",
    "@rspack/core": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "postcss-loader": "^8.1.1",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
